{
  "name": "kirana-erp-backend",
  "version": "1.0.0",
  "description": "Kirana ERP + POS backend API (Phase 1: Auth/RBAC/Masters. Phase 9-10: WhatsApp/SMS + Online Store)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node -e \"require('./src/config/db').runSqlFile('../../../database/schema.sql')\"",
    "seed": "node -e \"require('./src/config/db').runSqlFile('../../../database/seed.sql')\"",
    "migrate:comm": "node -e \"require('./src/config/db').runSqlFile('../../../database/002_communications_and_store_schema.sql')\"",
    "seed:comm": "node -e \"require('./src/config/db').runSqlFile('../../../database/002_communications_and_store_seed.sql')\"",
    "seed:admin": "node scripts/seedAdmin.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "dotenv": "^16.4.5",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "express-validator": "^7.1.0",
    "express-rate-limit": "^7.4.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18"
  }
}
